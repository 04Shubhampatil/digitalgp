# Copy to .env for local development. Never commit .env.
DATABASE_URL="postgresql://admin:admin@localhost:5432/digitalgp?schema=public"

# Base host used for subdomain tenant resolution (e.g. ganeshwadi.digitalgp.in)
APP_BASE_HOST="digitalgp.in"
# Public origin of the admin app, used for CSRF origin checks and reset links
APP_ORIGIN="http://localhost:3000"

# Seed-only: initial super admin (dev). Change immediately in any shared environment.
SEED_SUPER_ADMIN_EMAIL="superadmin@digitalgp.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe-Now-2026!"

# Where uploaded media files are stored (relative to the app root or absolute). Git-ignored.
UPLOADS_DIR="uploads"
