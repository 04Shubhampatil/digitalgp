# Copy to .env for local development. Never commit .env.
DATABASE_URL="postgresql://admin:admin@localhost:5432/digitalgp?schema=public"

# Base host used for subdomain tenant resolution (e.g. ganeshwadi.digitalgp.in)
APP_BASE_HOST="digitalgp.in"
# Public origin of the admin app, used for CSRF origin checks and reset links
APP_ORIGIN="http://localhost:3000"

# Seed-only: initial super admin (dev). Change immediately in any shared environment.
SEED_SUPER_ADMIN_EMAIL="superadmin@digitalgp.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe-Now-2026!"

# Where uploaded media files are stored (relative to the app root or absolute). Git-ignored.
UPLOADS_DIR="uploads"

# Cloudflare Turnstile public site key (not a secret). The CAPTCHA widget is shown on public forms when set;
# the matching TURNSTILE_SECRET_KEY on the server turns the check on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Complaint attachments uploaded by citizens: hours an unattached file is kept, and the cap on pending files per website.
GRIEVANCE_UPLOAD_TTL_HOURS=24
GRIEVANCE_UPLOAD_MAX_PENDING=200

# Live weather. Leave the key empty to show the design card only. Never commit the real key: set it in .env (local)
# and in the host environment (Vercel). WEATHER_PROVIDER is "weatherapi" (WeatherAPI.com) or "openweathermap".
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
# WEATHER_API_BASE_URL is only needed for a non-default address of the chosen provider.
# WEATHER_CACHE_MINUTES=15

# Set to off once the website has had its design content published (npm run content:publish-design): the public pages then draw only published sections and records.
# NEXT_PUBLIC_DESIGN_FALLBACKS=off
